{
    "mcpServers": {
        "drawio": {
            "command": "npx",
            "args": [
                "-y",
                "@next-ai-drawio/mcp-server@latest"
            ],
            "autoApprove": []
        },
        "pencil": {
            "description": "Pencil - Visual design MCP server",
            "type": "stdio",
            "command": "%USERPROFILE%\\.pencil\\mcp\\visual_studio_code\\out\\mcp-server-windows-x64.exe",
            "args": [
                "--app",
                "visual_studio_code",
                "--agent",
                "codexCLI"
            ],
            "env": {},
            "cwd": "~/code",
            "autoApprove": []
        },
        "minimax_search": {
            "description": "MiniMax Search - Powerful web search and intelligent browsing ⭐",
            "type": "stdio",
            "command": "uvx",
            "args": [
                "--from",
                "git+https://github.com/MiniMax-AI/minimax_search",
                "minimax-search"
            ],
            "env": {
                "JINA_API_KEY": "",
                "SERPER_API_KEY": "",
                "MINIMAX_API_KEY": ""
            },
            "disabled": true
        },
        "memory": {
            "description": "Memory - Knowledge graph memory system (long-term memory based on graph database)",
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "disabled": true
        }
    }
}
