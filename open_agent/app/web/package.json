{
  "name": "open-agent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vue-tsc --noEmit && vite build",
    "test:workspace-selection": "node scripts/test-workspace-selection.mjs",
    "test:message-queue": "node scripts/test-message-queue.mjs",
    "test:runtime-task": "node scripts/test-runtime-task.mjs",
    "test:collaboration-state": "node scripts/test-collaboration-state.mjs",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:open": "cap open android",
    "mobile:build": "npm run mobile:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "2.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
