{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenAgentSeal",
  "version": "0.1.0",
  "identifier": "com.openagentseal.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:10086",
    "frontendDist": "../../open_agent/app/static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenAgentSeal",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "splash",
        "title": "OpenAgentSeal",
        "url": "splash.html",
        "width": 430,
        "height": 286,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../../icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/open-agent-backend"]
  }
}
